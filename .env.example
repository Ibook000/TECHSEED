# 服务端口（默认 3000，范围 1–65535）
PORT=3000
# 监听地址（默认仅本机可访问；Docker Compose 会覆盖为容器内的 0.0.0.0）
HOST=127.0.0.1
# 页面展示的学校名称（仅构建前端时读取；留空时显示 xxxxx学院）
VITE_ORGANIZATION_NAME="xxxxx学院"
# 可信反向代理层数（0–10）；直连部署保持 0。仅在代理链路可信且层数明确时设置
TRUST_PROXY_HOPS=0

# OpenAI 兼容 API 主配置（如 DeepSeek、OpenAI、Moonshot、Qwen 等）
# 支持多 Key 负载均衡：逗号分隔，例如 "sk-a,sk-b,sk-c"
# 留空则仅使用内置启发式评估引擎（无网络调用）
OPENAI_API_KEY=""
OPENAI_API_KEYS=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# 降级备用池：主配置全部失败时启用（可选）
FALLBACK_OPENAI_API_KEY=""
FALLBACK_OPENAI_API_KEYS=""
FALLBACK_OPENAI_BASE_URL=""
FALLBACK_OPENAI_MODEL=""

# LLM 并发上限（默认 10）；最多 100 个等待请求，等待超过 30 秒会降级到启发式引擎
LLM_MAX_CONCURRENT=10

# 管理员初始密码（首次创建数据库前必填；12–128 个字符，按原文校验且不能全为空白）
ADMIN_DEFAULT_PASSWORD=""

# 管理端 Token 签名密钥（可选；至少 32 字节随机值；留空则自动生成并持久化）
# 推荐生成：openssl rand -base64 32
AUTH_TOKEN_SECRET=""

# 开发模式：设为 true 时禁用 HMR 与文件监听
# DISABLE_HMR=false
