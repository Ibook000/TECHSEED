# 服务端口（默认 3000）
PORT=3000
# 可信反向代理层数；直连部署保持 0。仅在代理链路可信且层数明确时设置
TRUST_PROXY_HOPS=0

# OpenAI 兼容 API 主配置（如 DeepSeek、OpenAI、Moonshot、Qwen 等）
# 支持多 Key 负载均衡：逗号分隔，例如 "sk-a,sk-b,sk-c"
# 留空则仅使用内置启发式评估引擎（无网络调用）
OPENAI_API_KEY=""
OPENAI_API_KEYS=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# 降级备用池：主配置全部失败时启用（可选）
FALLBACK_OPENAI_API_KEY=""
FALLBACK_OPENAI_API_KEYS=""
FALLBACK_OPENAI_BASE_URL=""
FALLBACK_OPENAI_MODEL=""

# LLM 并发上限（默认 10）；最多 100 个等待请求，等待超过 30 秒会降级到启发式引擎
LLM_MAX_CONCURRENT=10

# 管理员初始密码（首次创建数据库前必填；使用唯一强密码）
ADMIN_DEFAULT_PASSWORD=""

# 管理端 Token 签名密钥（可选；留空则自动生成并持久化到数据库）
AUTH_TOKEN_SECRET=""

# 开发模式：设为 true 时禁用 HMR 与文件监听
# DISABLE_HMR=false
