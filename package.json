{
  "name": "techseed-recruitment",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node scripts/start-production.mjs",
    "backup": "node scripts/backup-db.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "test": "node --import tsx --test tests/evaluation.test.ts tests/manualReview.test.ts tests/routeParams.test.ts tests/express5Routes.test.ts tests/passwordPolicy.test.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "canvas-confetti": "^1.9.4",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.546.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^8.3.4"
  }
}
